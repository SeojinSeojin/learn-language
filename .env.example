# Copy to .env for local runs (`cp .env.example .env`). .env is auto-loaded and gitignored.
# Placeholders only: never commit real values.

# ── Required ────────────────────────────────────────────────────────────────
# Gemini (Google AI Studio, free tier) writes the dialogue. This is the only key needed to generate a video.
GEMINI_API_KEY=your-gemini-api-key
# Optional. Dialogue model; empty = gemini-3.6-flash
GEMINI_MODEL=

# ── Speech ──────────────────────────────────────────────────────────────────
# edge   (default) Microsoft Edge TTS. No API key, no sign-up, no daily limit.
#        Needs the Python CLI once: pip install -r requirements-tts.txt
# gemini Gemini TTS. Uses GEMINI_API_KEY above; free tier is about 2 videos/day.
TTS_PROVIDER=edge

# Edge TTS (TTS_PROVIDER=edge). All optional; nothing to fill in for the defaults.
# Voices per character and language, checked against Edge's voice list before use.
# Empty = es-MX-DaliaNeural / ko-KR-SunHiNeural for Lupita, es-MX-JorgeNeural / ko-KR-InJoonNeural for Jisoo.
EDGE_TTS_VOICE_LUPITA_ES=
EDGE_TTS_VOICE_LUPITA_KO=
EDGE_TTS_VOICE_JISOO_ES=
EDGE_TTS_VOICE_JISOO_KO=
# Path to the edge-tts command if it is not on PATH (e.g. inside a virtualenv).
# EDGE_TTS_BIN=.venv/bin/edge-tts
# Per-line TTS cache folder; empty = .cache/tts
TTS_CACHE_DIR=

# Gemini TTS (TTS_PROVIDER=gemini only). All optional.
# TTS model; empty = gemini-3.8-flash-lite-tts
GEMINI_TTS_MODEL=
# Prebuilt Gemini voices per character and language. Empty = Leda for Lupita, Charon for Jisoo.
GEMINI_TTS_VOICE_LUPITA_ES=
GEMINI_TTS_VOICE_LUPITA_KO=
GEMINI_TTS_VOICE_JISOO_ES=
GEMINI_TTS_VOICE_JISOO_KO=
# Free-tier pacing (requests per minute). Default 3.
GEMINI_TTS_RPM=

# ── YouTube upload (only for `npm run youtube:authorize` / `npm run youtube:upload`) ──
# Desktop-app OAuth client from Google Cloud Console.
YOUTUBE_CLIENT_ID=your-desktop-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-desktop-client-secret
# Optional locally: `npm run youtube:authorize` writes the refresh token to
# .secrets/youtube-token.json (mode 0600). Required as a GitHub secret in CI.
YOUTUBE_REFRESH_TOKEN=

# ── Optional: ffmpeg/ffprobe locations if they are not on PATH ──
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
